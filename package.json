{
  "name": "subli-b",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env servidor.js",
    "dev": "node --watch --env-file-if-exists=.env servidor.js",
    "check": "node --check servidor.js && for archivo in servidor/*.js src/*.js; do node --check \"$archivo\" || exit 1; done"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
